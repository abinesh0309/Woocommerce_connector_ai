# Store + key (alternative to `woo-connector auth`). Env vars override the saved credentials file.
WOO_STORE_URL=https://your-shop.example
WOO_CONSUMER_KEY=ck_xxx
WOO_CONSUMER_SECRET=cs_xxx

WOO_KEY_PERMISSIONS=read

# Output privacy: masked (default) | full
WOO_PII_MODE=masked

# Being a good citizen to the merchant's server
WOO_MAX_RPS=4
WOO_BURST=8
WOO_CACHE_TTL=0          
WOO_VERIFY_TLS=true      

# HTTP transport (`woo-connector serve --http`)
WOO_MCP_TOKEN=change-me-long-random

# Logging (stderr only)
WOO_LOG_LEVEL=INFO
WOO_LOG_FORMAT=text    

# Reference agent (`woo-connector chat`)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Dashboard + chat (`woo-connector web`)
WOO_WEB_PASSWORD=change-me-long-random  
WOO_WEB_SECRET=                         
